# Copia este archivo a infra/.env y rellena con los valores reales.
# infra/.env esta en .gitignore, nunca se sube al repo.
#
# Los valores de EAGLEBOOTS_S3_BUCKET y EAGLEBOOTS_CF_DISTRIBUTION_ID salen de:
#   cd infra
#   docker compose run --rm terraform output

EAGLEBOOTS_S3_BUCKET=eagleboots-frontend-site
EAGLEBOOTS_CF_DISTRIBUTION_ID=E1A2B3C4D5E6F7

AWS_PROFILE=eagleboots
AWS_REGION=us-east-1
